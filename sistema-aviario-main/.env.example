# ===========================================================================
# Modelo de configuracao. Copie para .env e preencha:
#
#   cp .env.example .env          (Linux/macOS)
#   Copy-Item .env.example .env   (PowerShell)
#
# O .env NUNCA vai para o git (ja esta no .gitignore).
# Use um .env diferente por ambiente (dev / homologacao / producao).
#
# Para gerar segredos fortes:
#   openssl rand -base64 48
#   PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
# ===========================================================================


# --- Ambiente --------------------------------------------------------------
# Production em servidor. Nunca deixe Development em producao: e o que
# habilita Swagger automatico e mensagens de erro detalhadas na resposta HTTP.
ASPNETCORE_ENVIRONMENT=Production


# --- Banco de dados --------------------------------------------------------
# A porta 1433 NAO e publicada: o SQL Server so existe dentro da rede do
# compose. Nada aqui deve ser reutilizado entre ambientes.
#
# Restricao das senhas de banco: use apenas letras, numeros e ! # % - _
# (o script de init passa a senha ao sqlcmd, e $ ' " quebram a substituicao).
MSSQL_SA_PASSWORD=troque-esta-senha-do-sa
DB_NAME=FarmSystemDb
DB_APP_USER=farmsystem_app
DB_APP_PASSWORD=troque-esta-senha-do-app


# --- JWT -------------------------------------------------------------------
# Minimo 32 caracteres. Trocar esta chave invalida todos os tokens ativos
# (todo mundo precisa logar de novo) - o que e exatamente o desejado se a
# chave antiga vazou.
JWT_KEY=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres
JWT_ISSUER=FarmSystemProject
JWT_AUDIENCE=FarmSystemProject
JWT_EXPIRATION_MINUTES=60


# --- ESP32 -----------------------------------------------------------------
# Mesma chave que vai em esp32/src/secrets.h (SECRET_KEY).
# Minimo 24 caracteres.
ESP32_SECRET_KEY=troque-por-uma-chave-aleatoria-de-no-minimo-24-caracteres


# --- Frontend --------------------------------------------------------------
# URL publica do frontend. Entra no link de redefinicao de senha enviado
# por e-mail, entao precisa ser a URL que o usuario final acessa.
FRONTEND_BASE_URL=https://aviario.seudominio.com

# Onde o container do frontend escuta no host.
# 127.0.0.1 (padrao) presume um proxy com TLS na frente - o recomendado.
# So use 0.0.0.0 se este container for a borda, ciente de que sera HTTP puro.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# URL base da API vista pelo navegador. Vazio = mesma origem, via proxy
# /api do nginx do frontend. So preencha se a API ficar em outro dominio
# (e, nesse caso, preencha tambem CORS_ALLOWED_ORIGIN_0 abaixo).
EXPO_PUBLIC_API_URL=


# --- CORS ------------------------------------------------------------------
# Lista explicita de origens permitidas. Vazio = nenhuma origem externa,
# apenas mesma origem. Nunca use "*" aqui.
# Ex.: CORS_ALLOWED_ORIGIN_0=https://aviario.seudominio.com
CORS_ALLOWED_ORIGIN_0=
CORS_ALLOWED_ORIGIN_1=

# Hosts aceitos pelo Kestrel. Em producao, prefira o dominio real
# em vez de *. Ex.: ALLOWED_HOSTS=aviario.seudominio.com
ALLOWED_HOSTS=*


# --- E-mail (SMTP) ---------------------------------------------------------
# Obrigatorio em Production: sem isso a API nao sobe.
# No Gmail, use uma "senha de app" - e revogue a antiga se ela ja vazou.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USER=seu-email@exemplo.com
EMAIL_PASSWORD=sua-senha-de-app
EMAIL_FROM=Farm System


# --- Swagger ---------------------------------------------------------------
# false em producao. Ligue temporariamente so para cadastrar sensores
# (veja o README) e desligue logo em seguida.
SWAGGER_ENABLED=false


# --- Desenvolvimento local -------------------------------------------------
# Descomente a linha abaixo no .env da sua maquina para que um simples
# "docker compose up -d" ja aplique a sobreposicao de desenvolvimento.
# COMPOSE_PATH_SEPARATOR=;
# COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml

# O servico frontend fica atras de um profile (veja docker-compose.yml).
# Sem isso, "docker compose up" local nao sobe o frontend.
# COMPOSE_PROFILES=full
